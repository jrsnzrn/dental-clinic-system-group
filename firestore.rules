rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        staffDoc().data.get("disabled", false) != true;
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function role() {
      return isStaff() && staffDoc().data.get("role", "") is string
        ? staffDoc().data.get("role", "").trim().lower()
        : "";
    }

    function isAdmin() {
      return role() == "admin";
    }

    function isReceptionist() {
      return role() == "receptionist";
    }

    function isDentist() {
      return role() == "dentist";
    }

    function isAdminOrReceptionist() {
      return isAdmin() || isReceptionist();
    }

    function isPaymentsStaff() {
      return isStaff() &&
        role() is string &&
        (role().matches("(?i)^admin$") || role().matches("(?i)^receptionist$"));
    }

    function dentistOwnsBooking() {
      return isDentist() && resource.data.dentistId is string &&
        exists(/databases/$(database)/documents/dentists/$(resource.data.dentistId)) &&
        get(/databases/$(database)/documents/dentists/$(resource.data.dentistId)).data.linkedStaffUid == request.auth.uid;
    }

    function isAnyStaffRole() {
      return isAdmin() || isReceptionist() || isDentist();
    }

    function patientDetailsAreValid(data) {
      return data.firstName is string &&
        data.firstName.matches(".*[^\\s].*") &&
        data.lastName is string &&
        data.lastName.matches(".*[^\\s].*") &&
        data.name is string &&
        data.name.matches(".*[^\\s].*") &&
        data.age is string &&
        data.age.matches("^[1-9][0-9]*$") &&
        data.phone is string &&
        data.phone.matches("^09[0-9]{9}$") &&
        data.email is string &&
        data.email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$") &&
        data.address is string &&
        data.address.matches(".*[^\\s].*") &&
        data.patientType in ["Regular", "Ortho"] &&
        (
          (data.patientType == "Regular" && !data.keys().hasAny(["bracesType"])) ||
          (
            data.patientType == "Ortho" &&
            (!data.keys().hasAny(["bracesType"]) || data.bracesType in ["Metal", "Ceramic", "Self-Ligating", "Sapphire"])
          )
        );
    }

    function patientDetailsAreChanging() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "firstName",
        "middleName",
        "lastName",
        "name",
        "age",
        "phone",
        "email",
        "address",
        "patientType",
        "bracesType"
      ]);
    }

    function patientProfileCreateKeysAreSafe(uid) {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "firstName",
        "middleName",
        "lastName",
        "fullName",
        "age",
        "phone",
        "patientType",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.uid == uid &&
      request.resource.data.patientType == "New Patient";
    }

    function patientProfileSelfUpdateKeysAreSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "email",
        "firstName",
        "middleName",
        "lastName",
        "fullName",
        "age",
        "phone",
        "updatedAt"
      ]);
    }

    function isPendingBookingRequest(booking, field) {
      let bookingRequest = booking.get(field, null);
      return bookingRequest is map && bookingRequest.get("status", "") == "pending";
    }

    function isBookingRequestWithdrawal(field) {
      return !(field in request.resource.data) && isPendingBookingRequest(resource.data, field);
    }

    function patientOwnBookingUpdateIsValid() {
      return request.auth.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "notes",
          "rescheduleRequest",
          "cancellationRequest"
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["cancellationRequest"]) ||
          isBookingRequestWithdrawal("cancellationRequest")) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["rescheduleRequest"]) ||
          isBookingRequestWithdrawal("rescheduleRequest")) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.patientProfileId == resource.data.patientProfileId &&
        request.resource.data.patientType == resource.data.patientType &&
        request.resource.data.selectedDentist == resource.data.selectedDentist &&
        request.resource.data.dentistId == resource.data.dentistId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.time == resource.data.time &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.checkedInAt == resource.data.checkedInAt &&
        request.resource.data.get("privacyConsentAccepted", null) == resource.data.get("privacyConsentAccepted", null) &&
        request.resource.data.get("privacyConsentText", null) == resource.data.get("privacyConsentText", null);
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /patientProfiles/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdminOrReceptionist() ||
        (isDentist() && resource.data.authorizedDentistUids is list && resource.data.authorizedDentistUids.hasAny([request.auth.uid]))
      );

      allow create: if
        (isSignedIn() && request.auth.uid == uid && patientProfileCreateKeysAreSafe(uid)) ||
        isAdminOrReceptionist();

      allow update: if
        (isSignedIn() && request.auth.uid == uid && patientProfileSelfUpdateKeysAreSafe()) ||
        isAdminOrReceptionist();

      allow delete: if false;
    }

    match /patients/{id} {
      allow read: if isAdminOrReceptionist() ||
        (isDentist() && resource.data.authorizedDentistUids is list && resource.data.authorizedDentistUids.hasAny([request.auth.uid]));
      allow create: if isAdminOrReceptionist() && patientDetailsAreValid(request.resource.data);
      allow delete: if isAdmin();
      allow update: if
        (
          isAdmin() ||
          (isReceptionist() &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status", "archiveStatus"]))
        ) &&
        (!patientDetailsAreChanging() || patientDetailsAreValid(request.resource.data));
    }

    match /bookings/{id} {
      allow create: if false;

      allow read: if
        isAdminOrReceptionist() || dentistOwnsBooking() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);

      allow update: if
        isSignedIn() && patientOwnBookingUpdateIsValid();

      allow delete: if false;
    }

    match /bookingSlotLocks/{id} {
      allow read, write: if false;
    }

    match /dentists/{id} {
      allow read: if true;
      allow create, update, delete: if isAdminOrReceptionist();
    }

    match /clinicServices/{id} {
      allow read: if true;
      allow create, update, delete: if isAdminOrReceptionist();
    }

    match /clinicClosures/{id} {
      allow read: if true;
      allow create, update, delete: if isAdminOrReceptionist();
    }

    match /promotions/{id} {
      allow read: if isAdmin() || resource.data.status == "active";
      allow create, update, delete: if isAdmin();
    }

    match /dentalCharts/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdminOrReceptionist() ||
        (isDentist() && resource.data.authorizedDentistUids is list && resource.data.authorizedDentistUids.hasAny([request.auth.uid]))
      );

      allow create: if isAdmin() ||
        (isDentist() && request.resource.data.authorizedDentistUids is list &&
          request.resource.data.authorizedDentistUids.hasAny([request.auth.uid]));
      allow update: if isAdmin() ||
        (isDentist() &&
          resource.data.authorizedDentistUids is list && resource.data.authorizedDentistUids.hasAny([request.auth.uid]) &&
          request.resource.data.authorizedDentistUids == resource.data.authorizedDentistUids);
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdminOrReceptionist();
      allow create: if false;
      allow update, delete: if false;
    }

    match /staffMfaChallenges/{id} {
      allow read, write: if false;
    }

    match /staffEmailVerificationChallenges/{id} {
      allow read, write: if false;
    }

    match /staffPasswordResetChallenges/{id} {
      allow read, write: if false;
    }

    match /bracesAccounts/{id} {
      allow read: if isSignedIn() && (
        isAdminOrReceptionist() ||
        resource.data.uid == request.auth.uid
      );

      allow create, update: if isAdminOrReceptionist();
      allow delete: if isAdmin();
    }

    match /bracesPricing/{id} {
      allow read: if isAdminOrReceptionist();
      allow create, update: if isAdmin() &&
        id == "reference" &&
        request.resource.data.keys().hasOnly(["prices", "updatedAt"]);
      allow delete: if isAdmin();
    }

    match /bracesPayments/{id} {
      allow read: if isSignedIn() && (
        isAdminOrReceptionist() ||
        resource.data.uid == request.auth.uid
      );

      allow create: if isAdminOrReceptionist() && validNewPaymentReference(request.resource.data);
      allow update: if isAdminOrReceptionist() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["receiptPhotos", "method", "referenceNumber"]);
      allow delete: if isAdmin();
    }

    function validNewPaymentReference(data) {
      let method = data.get("method", "Cash");
      let reference = data.get("referenceNumber", "");
      return data.get("receiptPhotos", []) == [] &&
        method is string && reference is string && reference.size() <= 100 &&
        (method == "Cash" ? reference == "" : reference.trim().size() > 0);
    }

    function validChargeBreakdown(data) {
      let breakdown = data.get("chargeBreakdown", null);
      return breakdown == null || (breakdown is map &&
        breakdown.serviceCharges is list && breakdown.serviceCharges.size() <= 30 &&
        breakdown.grossTotal is number && breakdown.grossTotal > 0 &&
        breakdown.eligibleTotal is number && breakdown.eligibleTotal >= 0 && breakdown.eligibleTotal <= breakdown.grossTotal &&
        breakdown.discountAmount is number && breakdown.discountAmount >= 0 && breakdown.discountAmount <= breakdown.eligibleTotal &&
        breakdown.totalCost == data.totalCost &&
        data.totalCost >= breakdown.grossTotal - breakdown.discountAmount - 0.005 &&
        data.totalCost <= breakdown.grossTotal - breakdown.discountAmount + 0.005);
    }

    match /payments/{id} {
      allow read: if isPaymentsStaff() ||
        (isSignedIn() && resource.data.get("uid", "") == request.auth.uid);
      allow create: if isAdminOrReceptionist() &&
        request.resource.data.keys().hasOnly([
          "patientId",
          "uid",
          "patientName",
          "patientEmail",
          "patientType",
          "appointmentId",
          "treatmentId",
          "treatmentName",
          "totalCost",
          "amount",
          "paymentDate",
          "referenceNumber",
          "additionalServices",
          "chargeBreakdown",
          "balanceAfterPayment",
          "amountPaidBefore",
          "paymentGroupId",
          "receiptPhotos",
          "method",
          "notes",
          "createdAt"
        ]) &&
        request.resource.data.patientId is string &&
        request.resource.data.treatmentId is string &&
        request.resource.data.get("paymentGroupId", "") is string &&
        request.resource.data.patientType in ["Regular", "Ortho"] &&
        validNewPaymentReference(request.resource.data) && validChargeBreakdown(request.resource.data) &&
        request.resource.data.get("additionalServices", []) is list &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.totalCost is number &&
        request.resource.data.totalCost > 0;
      allow update, delete: if false;
    }

    match /paymentTreatmentSummaries/{id} {
      allow read: if isPaymentsStaff();
      allow create, update: if isAdminOrReceptionist() &&
        request.resource.data.keys().hasOnly([
          "patientId",
          "uid",
          "patientName",
          "patientEmail",
          "patientType",
          "treatmentId",
          "appointmentId",
          "treatmentName",
          "procedureName",
          "additionalServices",
          "chargeBreakdown",
          "totalCost",
          "amountPaid",
          "remainingBalance",
          "createdAt",
          "updatedAt"
        ]) &&
        request.resource.data.patientId is string &&
        request.resource.data.treatmentId is string &&
        request.resource.data.patientType in ["Regular", "Ortho"] &&
        request.resource.data.get("additionalServices", []) is list &&
        validChargeBreakdown(request.resource.data) &&
        request.resource.data.totalCost is number &&
        (request.resource.data.totalCost > 0 ||
          (request.resource.data.totalCost == 0 && request.resource.data.get("chargeBreakdown", null) is map &&
            request.resource.data.chargeBreakdown.grossTotal > 0)) &&
        request.resource.data.amountPaid is number &&
        request.resource.data.amountPaid >= 0 &&
        request.resource.data.amountPaid <= request.resource.data.totalCost &&
        request.resource.data.remainingBalance is number &&
        request.resource.data.remainingBalance >= 0 &&
        request.resource.data.remainingBalance <= request.resource.data.totalCost;
      allow delete: if false;
    }

    match /bracesAdjustments/{id} {
      allow read: if isSignedIn() && (
        isAdminOrReceptionist() ||
        resource.data.uid == request.auth.uid
      );

      allow create, update: if isAdminOrReceptionist();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
